{
  "permissions": {
    "allow": [
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh search issues *)",
      "Bash(gh issue list *)",
      "Bash(gh repo list *)",
      "Bash(gh workflow view *)",
      "Bash(git remote get-url *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git pull *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git branch *)",
      "Bash(git status *)",
      "Bash(git worktree *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go mod *)",
      "Bash(go doc *)",
      "Bash(go fmt *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(staticcheck *)",
      "Bash(make *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(xargs *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(diff *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(jq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(chmod *)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.github.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(rm *)",
      "Bash(curl *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*credentials*)",
      "Read(**/*password*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/*.key)",
      "Read(**/*_token)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/id_rsa*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/id_rsa*)"
    ]
  },
  "env": {
    "PROJECT_NAME": "grove"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.py"
          }
        ]
      }
    ]
  }
}
